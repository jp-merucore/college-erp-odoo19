<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="college_course_list" model="ir.ui.view">
        <field name="name">college.course.list</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <list string="College Courses">

                <field name="course_code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="fees" widget="monetary"/>
                <field name="state" widget="badge"/>

            </list>
        </field>
    </record>

    <record id="college_course_form" model="ir.ui.view">
        <field name="name">college.course.form</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <form string="College Course">

                <header>

                    <button name="action_start"
                            string="Start"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            invisible="state != 'running'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state == 'cancel'"/>

                    <button name="action_reset_draft"
                            string="Reset Draft"
                            type="object"
                            invisible="state == 'draft'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,running,completed,cancel"/>

                    <button name="action_view_subjects"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">

                        <field name="subject_count"
                               widget="statinfo"
                               string="Subjects"/>

                    </button>

                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_students"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="total_students"
                                   widget="statinfo"
                                   string="Students"/>

                        </button>

                    </div>

                    <group>
                        <group>


                            <field name="name"/>

                            <field name="department_id"/>

                            <field name="fees"
                                   widget="monetary"/>

                        </group>

                        <group>

                            <field name="start_date"
                                   widget="daterange"
                                   options="{'end_date_field': 'end_date'}"/>

                            <field name="end_date"
                                   invisible="1"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Students">

                            <field name="student_ids"
                                   widget="many2many_tags"/>

                        </page>

                        <page string="Description">

                            <field name="description"/>

                        </page>

                        <page string="Subjects">

                            <field name="subject_ids">

                                <list editable="bottom">

                                    <field name="subject_code"/>

                                    <field name="name"/>

                                    <field name="semester"/>

                                    <field name="credits"/>

                                </list>

                            </field>

                        </page>

                        <page string="Subjects">

                            <field name="subject_ids">

                                <list editable="bottom">

                                    <field name="subject_code"/>

                                    <field name="name"/>

                                    <field name="semester"/>

                                    <field name="credits"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </chatter>

            </form>
        </field>
    </record>

    <record id="college_course_search" model="ir.ui.view">
        <field name="name">college.course.search</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <search>
                <filter
                        name="Draft"
                        string="draft"
                        domain="[('state','=', 'draft')]"
                />
                <filter
                        name="Running"
                        string="running"
                        domain="[('state','=', 'running')]"
                />

                <filter string="Completed"
                        name="completed"
                        domain="[('state','=','completed')]"
                />

                <group>
                    <field name="name"/>
                    <field name="course_code"/>
                    <field name="department_id"/>
                </group>
                <group>
                    <filter string="Department" name="group_department" domain="[]"
                            context="{'group_by':'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_college_course" model="ir.actions.act_window">
        <field name="name">College Courses</field>
        <field name="res_model">college.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="college_course_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Course!
            </p>
        </field>
    </record>

</odoo>