<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="college_department_list" model="ir.ui.view">
        <field name="name">college.department.list</field>
        <field name="model">college.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="department_code"/>
                <field name="name"/>

            </list>
        </field>
    </record>

    <record id="college_department_form" model="ir.ui.view">
        <field name="name">college.department.form</field>
        <field name="model">college.department</field>
        <field name="arch" type="xml">
            <form string="Department">

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_students"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="student_count"
                                   widget="statinfo"
                                   string=" Total Students"/>

                        </button>
                        <button name="action_view_courses"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="course_count"
                                   widget="statinfo"
                                   string=" Total Courses"/>

                        </button>

                    </div>

                    <group>
                        <group>

                            <field name="name"/>

                            <field name="department_code"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="description"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Students">

                            <field name="student_ids"
                                   readonly="1">

                                <list>
                                    <field name="student_code"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="state"/>
                                </list>

                            </field>

                        </page>

                        <page string="Courses">

                            <field name="course_ids"
                                   readonly="1">

                                <list>
                                    <field name="course_code"/>
                                    <field name="name"/>
                                    <field name="fees"/>
                                    <field name="state"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <record id="college_department_search" model="ir.ui.view">
        <field name="name">college.department.search</field>
        <field name="model">college.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_code"/>

                <filter string="Group By Department"
                        name="group_by_department"
                        context="{'group_by':'name'}"/>

            </search>
        </field>
    </record>


    <record id="action_college_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">college.department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="college_department_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Department!
            </p>
        </field>
    </record>

</odoo>
