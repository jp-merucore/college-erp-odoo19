<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 
                    Tree View
   -->

    <record id="view_college_subject_list" model="ir.ui.view">
        <field name="name">college.subject.list</field>
        <field name="model">college.subject</field>
        <field name="arch" type="xml">

            <list>

                <field name="subject_code"/>

                <field name="name"/>

                <field name="department_id"/>

                <field name="course_id"/>

                <field name="semester"/>

                <field name="credits"/>

            </list>

        </field>
    </record>


    <!-- 
                    Form View
   -->

    <record id="view_college_subject_form" model="ir.ui.view">
        <field name="name">college.subject.form</field>
        <field name="model">college.subject</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <group>

                            <field name="subject_code"/>

                            <field name="name"/>

                            <field name="department_id"/>

                            <field name="course_id"/>

                        </group>

                        <group>

                            <field name="semester"/>

                            <field name="credits"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Description">

                            <field name="description"/>

                        </page>

                        <page string="Teachers">

                            <field name="teacher_ids"
                                   widget="many2many_tags"/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- 
        Search View
 -->

    <record id="view_college_subject_search" model="ir.ui.view">
        <field name="name">college.subject.search</field>
        <field name="model">college.subject</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="subject_code"/>

                <field name="department_id"/>

                <field name="course_id"/>

                <field name="semester"/>

                <filter
                        name="active"
                        string="Active"
                        domain="[('active','=',True)]"/>

            </search>

        </field>
    </record>


    <!-- 
                    Action
   -->

    <record id="action_college_subject"
            model="ir.actions.act_window">

        <field name="name">Subjects</field>

        <field name="res_model">college.subject</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_college_subject_search"/>

    </record>

</odoo>
