<odoo>

    <data>
        <record id="college_student_list" model="ir.ui.view">
            <field name="name">college.student.list</field>
            <field name="model">college.student</field>
            <field name="arch" type="xml">
                <list string="College Student">
                    <field name="student_code"/>
                    <field name="name"/>
                    <field name="admission_date"/>
                    <field name="birth_date"/>
                    <field name="phone"/>
                    <field name="age"/>
                    <field name="total_fee" widget="monetary"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="college_student_form" model="ir.ui.view">
            <field name="name">college.student.form</field>
            <field name="model">college.student</field>
            <field name="arch" type="xml">
                <form string="College Student">
                    <header>

                        <button name="action_activate"
                                string="Activate"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_blocked"
                                string="Block"
                                type="object"
                                invisible="state != 'active'"/>

                        <button name="action_alumni"
                                string="Alumni"
                                type="object"
                                invisible="state != 'active'"/>

                        <button name="action_draft"
                                string="Reset Draft"
                                type="object"
                                invisible="state == 'draft'"/>

                        <button name="action_create_portal_user"
                                string="Create Portal User"
                                type="object"
                                class="btn-primary"
                                invisible="user_id != False"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,active,blocked,alumni"/>
                        <!-- widet="statusbar" used for look state as statusbar and statusbar_visible which state we need to show in statusbar-->
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">

                            <button name="action_view_attendance"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-calendar-check-o">

                                <field name="attendance_count"
                                       widget="statinfo"
                                       string="Attendance"/>
                            </button>

                            <button name="action_view_exam_results"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-graduation-cap">

                                <field name="exam_count"
                                       widget="statinfo"
                                       string="Exams"/>

                            </button>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex gap-3 align-items-start">

                                <field name="image_1920"
                                       widget="image"
                                       nolabel="1"
                                       class="oe_avatar"/>

                                <div class="flex-grow-1">

                                    <h1>
                                        <field name="name"
                                               nolabel="1"
                                               placeholder="e.g. Jalay Patel"/>
                                    </h1>

                                    <div class="text-muted mb-2">
                                        <i class="fa fa-envelope me-2" title="Email"/>
                                        <field name="email" nolabel="1"/>
                                    </div>

                                    <div class="text-muted">
                                        <i class="fa fa-phone me-2" title="Phone"/>
                                        <field name="phone" nolabel="1"/>
                                    </div>

                                </div>

                            </div>
                        </div>

                        <group>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="partner_id"/>
                                <field name="department_id"/>
                                <field name="course_ids"
                                       widget="many2many_tags"/>
                                <field name="admission_id" readonly="1"/>
                            </group>

                            <group>
                                <field name="admission_date"/>
                                <field name="birth_date"/>
                                <field name="age"/>
                            </group>
                        </group>

                        <notebook>

                            <page string="Fees">
                                <field name="fee_ids">
                                    <list editable="bottom">
                                        <field name="fee_number"/>
                                        <field name="amount"/>
                                        <field name="due_date"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>

                    </sheet>
                    <chatter>
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </chatter>
                </form>
            </field>
        </record>

        <record id="college_student_search" model="ir.ui.view">
            <field name="name">college.student.search</field>
            <field name="model">college.student</field>
            <field name="arch" type="xml">
                <search>
                    <filter
                            name="active_students"
                            string="Active"
                            domain="[('state','=', 'active')]"
                    />
                    <filter
                            name="blocked_students"
                            string="Blocked Qty"
                            domain="[('state','=', 'blocked')]"
                    />
                    <group>
                        <field name="name"/>
                        <field name="student_code"/>
                        <field name="department_id"/>
                    </group>
                    <group>
                        <filter string="Department" name="group_department" domain="[]"
                                context="{'group_by':'department_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="college_student_kanban" model="ir.ui.view">
            <field name="name">college.student.kanban</field>
            <field name="model">college.student</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="student_code"/>
                    <field name="department_id"/>
                    <field name="phone"/>
                    <field name="image_1920"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="text-center">
                                    <field name="image_1920" widget="image"/>
                                </div>

                                <strong>
                                    <field name="name"/>
                                </strong>

                                <div>
                                    <field name="student_code"/>
                                </div>

                                <div>
                                    <field name="department_id"/>
                                </div>

                                <div>
                                    <field name="phone"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="college_student_pivot" model="ir.ui.view">
            <field name="name">college.student.pivot</field>
            <field name="model">college.student</field>
            <field name="arch" type="xml">
                <pivot string="Student Analysis">
                    <field name="department_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="total_fee" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="college_student_calendar" model="ir.ui.view">
            <field name="name">college.student.calendar</field>
            <field name="model">college.student</field>
            <field name="arch" type="xml">
                <calendar
                        string="Students"
                        date_start="admission_date"
                        color="department_id">
                    <field name="name"/>
                    <field name="department_id"/>
                </calendar>
            </field>
        </record>


        <record id="action_college_student" model="ir.actions.act_window">
            <field name="name">College Student</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">college.student</field>
            <field name="view_mode">list,form,kanban,pivot,calendar</field>
            <field name="search_view_id" ref="college_student_search"/>
            <field name="help" type="html">
                <p>
                    Create first College Student!
                </p>
            </field>
        </record>

    </data>

</odoo>