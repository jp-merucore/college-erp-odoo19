<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ====================================================== -->
    <!-- Tree View -->
    <!-- ====================================================== -->

    <record id="view_college_notice_tree"
            model="ir.ui.view">

        <field name="name">college.notice.tree</field>
        <field name="model">college.notice</field>

        <field name="arch"
               type="xml">

            <list>

                <field name="notice_date"/>

                <field name="name"/>

                <field name="priority"/>

                <field name="department_ids"
                       widget="many2many_tags"/>

                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- ====================================================== -->
    <!-- Search View -->
    <!-- ====================================================== -->

    <record id="view_college_notice_search"
            model="ir.ui.view">

        <field name="name">college.notice.search</field>
        <field name="model">college.notice</field>

        <field name="arch"
               type="xml">

            <search>

                <field name="name"/>

                <field name="notice_date"/>

                <filter name="active"
                        string="Active"
                        domain="[('active','=',True)]"/>

                <filter name="inactive"
                        string="Inactive"
                        domain="[('active','=',False)]"/>

            </search>

        </field>

    </record>


    <!-- ====================================================== -->
    <!-- Form View -->
    <!-- ====================================================== -->

    <record id="view_college_notice_form"
            model="ir.ui.view">

        <field name="name">college.notice.form</field>

        <field name="model">college.notice</field>

        <field name="arch"
               type="xml">

            <form string="College Notice">

                <sheet>

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="notice_date"/>

                            <field name="expiry_date"/>

                            <field name="priority"/>

                            <field name="department_ids"
                                   widget="many2many_tags"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <notebook>

                        <!-- Description -->

                        <page string="Description">

                            <field name="description"
                                   widget="html"/>

                        </page>

                        <!-- Attachment -->

                        <page string="Attachment">

                            <group>

                                <field name="attachment"
                                       filename="attachment_name"/>

                                <field name="attachment_name"
                                       invisible="1"/>

                            </group>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ====================================================== -->
    <!-- Action -->
    <!-- ====================================================== -->

    <record id="action_college_notice"
            model="ir.actions.act_window">

        <field name="name">Notices</field>

        <field name="res_model">college.notice</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_college_notice_search"/>

    </record>


</odoo>