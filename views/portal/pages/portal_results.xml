<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="portal_results"
              name="Student Results">

        <t t-call="college_erp_ready.college_portal_layout">

            <div class="container mt-4">

                <!-- Header -->
                <div class="card portal-header shadow-lg mb-4">

                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-lg-8">

                                <h2 class="fw-bold">
                                    <i class="fa fa-graduation-cap me-2"/>
                                    My Examination Results
                                </h2>

                                <p class="mb-0">
                                    Overall Academic Performance
                                </p>

                            </div>

                            <div class="col-lg-4 text-center">

                                <h1 class="display-4 fw-bold">
                                    <t t-out="average"/>%
                                </h1>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Statistics -->

                <div class="row">

                    <div class="col-md-3 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-file-text fa-2x text-primary mb-2"/>

                                <h2>
                                    <t t-out="total_exam"/>
                                </h2>

                                <h6>Total Exams</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-check-circle fa-2x text-success mb-2"/>

                                <h2>
                                    <t t-out="passed"/>
                                </h2>

                                <h6>Passed</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-times-circle fa-2x text-danger mb-2"/>

                                <h2>
                                    <t t-out="failed"/>
                                </h2>

                                <h6>Failed</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-line-chart fa-2x text-info mb-2"/>

                                <h2>
                                    <t t-out="average"/>%
                                </h2>

                                <h6>Average</h6>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Progress -->

                <div class="card portal-card mb-4">

                    <div class="card-header">

                        <strong>Overall Performance</strong>

                    </div>

                    <div class="card-body">

                        <div class="progress"
                             style="height:30px;">

                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 t-attf-style="width: {{average}}%;">

                                <t t-out="average"/>%

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Results Table -->

                <div class="card portal-card">

                    <div class="card-header">

                        <strong>Examination History</strong>

                    </div>

                    <div class="card-body p-0">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>Exam</th>
                                    <th>Department</th>
                                    <th>Marks</th>
                                    <th>Percentage</th>
                                    <th>Result</th>

                                </tr>

                            </thead>

                            <tbody>

                                <t t-if="results">

                                    <tr t-foreach="results"
                                        t-as="res">

                                        <td>
                                            <t t-out="res.exam_id.name"/>
                                        </td>

                                        <td>
                                            <t t-out="res.department_id.name"/>
                                        </td>

                                        <td>
                                            <t t-out="res.marks"/>
                                            /
                                            <t t-out="res.exam_id.total_marks"/>
                                        </td>

                                        <td>
                                            <t t-out="round(res.percentage,2)"/>%
                                        </td>

                                        <td>

                                            <span t-if="res.result == 'pass'"
                                                  class="badge bg-success">

                                                PASS

                                            </span>

                                            <span t-if="res.result == 'fail'"
                                                  class="badge bg-danger">

                                                FAIL

                                            </span>

                                        </td>

                                    </tr>

                                </t>

                                <t t-else="">

                                    <tr>

                                        <td colspan="5"
                                            class="text-center p-4">

                                            No examination results available.

                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </t>

    </template>

</odoo>