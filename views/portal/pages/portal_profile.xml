<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="portal_student_profile"
              name="Student Profile">

        <t t-call="college_erp_ready.college_portal_layout">

            <div class="container mt-4">

                <!-- ======================================= -->
                <!-- Header -->
                <!-- ======================================= -->

                <div class="card portal-header shadow-lg mb-5">

                    <div class="card-body p-4 ">

                        <div class="row align-items-center">

                            <!-- Left -->

                            <div class="col-lg-8">

                                <h2 class="fw-bold">

                                    <i class="fa fa-user-circle me-2"/>

                                    My Profile

                                </h2>

                                <hr class="border-light"/>

                                <h4>

                                    <t t-out="student.name"/>

                                </h4>

                                <p>

                                    <strong>Student Code :</strong>

                                    <t t-out="student.student_code"/>

                                </p>

                                <p>

                                    <strong>Department :</strong>

                                    <t t-out="student.department_id.name"/>

                                </p>

                                <p>

                                    <strong>Admission Date :</strong>

                                    <span t-field="student.admission_date"/>

                                </p>

                                <p>

                                    <strong>Status :</strong>

                                    <span class="badge bg-success">

                                        <t t-out="student.state"/>

                                    </span>

                                </p>

                            </div>

                            <!-- Right -->

                            <div class="col-lg-4 text-center">

                                <t t-if="student.image_1920">

                                    <img t-att-src="image_data_uri(student.image_1920)"
                                         class="portal-avatar"/>

                                </t>

                                <t t-else="">

                                    <img src="/college_erp_ready/static/src/img/default_student.png"
                                         class="portal-avatar"/>

                                </t>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ======================================= -->
                <!-- Cards -->
                <!-- ======================================= -->

                <div class="row">

                    <!-- Personal -->

                    <div class="col-lg-6 mb-4">

                        <div class="card portal-card h-100">

                            <div class="card-header bg-primary text-white">

                                <h5 class="mb-0">

                                    <i class="fa fa-user me-2"/>

                                    Personal Information

                                </h5>

                            </div>

                            <div class="card-body">

                                <table class="table portal-info-table">

                                    <tr>

                                        <th>Gender</th>

                                        <td>

                                            <t t-out="student.gender or '-'"/>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Birth Date</th>

                                        <td>

                                            <span t-field="student.birth_date"/>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Age</th>

                                        <td>

                                            <t t-out="student.age"/>

                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <!-- Contact -->

                    <div class="col-lg-6 mb-4">

                        <div class="card portal-card h-100">

                            <div class="card-header bg-success text-white">

                                <h5 class="mb-0">

                                    <i class="fa fa-phone me-2"/>

                                    Contact Information

                                </h5>

                            </div>

                            <div class="card-body">

                                <table class="table portal-info-table">

                                    <tr>

                                        <th>Email</th>

                                        <td>

                                            <t t-out="student.email"/>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Phone</th>

                                        <td>

                                            <t t-out="student.phone"/>

                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ======================================= -->
                <!-- Statistics -->
                <!-- ======================================= -->

                <div class="row">

                    <div class="col-md-4 mb-4">

                        <div class="card portal-card">

                            <div class="card-body portal-stat">

                                <i class="fa fa-book"/>

                                <h3>

                                    <t t-out="len(student.course_ids)"/>

                                </h3>

                                <h6>Courses</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4 mb-4">

                        <div class="card portal-card">

                            <div class="card-body portal-stat">

                                <i class="fa fa-calendar"/>

                                <h3>

                                    <t t-out="student.attendance_count"/>

                                </h3>

                                <h6>Attendance</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4 mb-4">

                        <div class="card portal-card">

                            <div class="card-body portal-stat">

                                <i class="fa fa-graduation-cap"/>

                                <h3>

                                    <t t-out="student.exam_count"/>

                                </h3>

                                <h6>Exams</h6>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ======================================= -->
                <!-- Quick Actions -->
                <!-- ======================================= -->

                <div class="card portal-card">

                    <div class="card-header bg-dark text-white">

                        <h5 class="mb-0">

                            Quick Actions

                        </h5>

                    </div>

                    <div class="card-body text-center">

                        <a href="/my/dashboard"
                           class="btn btn-primary m-2">

                            Dashboard

                        </a>

                        <a href="/my/attendance"
                           class="btn btn-success m-2">

                            Attendance

                        </a>

                        <a href="/my/results"
                           class="btn btn-info text-white m-2">

                            Results

                        </a>

                        <a href="/my/fees"
                           class="btn btn-warning m-2">

                            Fees

                        </a>

                        <a href="/my/idcard"
                           class="btn btn-danger m-2">

                            ID Card

                        </a>

                    </div>

                </div>

            </div>

        </t>

    </template>

</odoo>