<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="portal_fees"
              name="Student Fees">

        <t t-call="college_erp_ready.college_portal_layout">

            <div class="container mt-4">

             
                <!-- Header -->
        

                <div class="card portal-header shadow-lg mb-4">

                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-lg-8">

                                <h2 class="fw-bold">

                                    <i class="fa fa-money me-2"/>

                                    My Fee Details

                                </h2>

                                <p class="mb-0">

                                    Fee Summary &amp; Payment History

                                </p>

                            </div>

                            <div class="col-lg-4 text-center">

                                <h2 class="fw-bold">

                                    ₹
                                    <t t-out="total_fee"/>

                                </h2>

                                <small>Total Fees</small>

                            </div>

                        </div>

                    </div>

                </div>

    
                <!-- Statistics -->
              

                <div class="row">

                    <div class="col-md-4 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-bank fa-2x text-primary mb-2"/>

                                <h3>

                                    ₹
                                    <t t-out="total_fee"/>

                                </h3>

                                <h6>Total Fees</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-check-circle fa-2x text-success mb-2"/>

                                <h3>

                                    ₹
                                    <t t-out="paid_fee"/>

                                </h3>

                                <h6>Paid Fees</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4 mb-4">

                        <div class="card portal-card">

                            <div class="card-body text-center">

                                <i class="fa fa-exclamation-circle fa-2x text-danger mb-2"/>

                                <h3>

                                    ₹
                                    <t t-out="pending_fee"/>

                                </h3>

                                <h6>Pending Fees</h6>

                            </div>

                        </div>

                    </div>

                </div>

              
                <!-- Fee History -->
    

                <div class="card portal-card">

                    <div class="card-header">

                        <strong>

                            Fee History

                        </strong>

                    </div>

                    <div class="card-body p-0">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>Fee Number</th>

                                    <th>Amount</th>

                                    <th>Due Date</th>

                                    <th>Status</th>

                                </tr>

                            </thead>

                            <tbody>

                                <t t-if="fees">

                                    <tr t-foreach="fees"
                                        t-as="fee">

                                        <td>

                                            <t t-out="fee.fee_number"/>

                                        </td>

                                        <td>

                                            ₹
                                            <t t-out="fee.amount"/>

                                        </td>

                                        <td>

                                            <span t-field="fee.due_date"/>

                                        </td>

                                        <td>

                                            <span t-if="fee.state == 'paid'"
                                                  class="badge bg-success">

                                                Paid

                                            </span>

                                            <span t-if="fee.state == 'pending'"
                                                  class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                            <span t-if="fee.state == 'cancel'"
                                                  class="badge bg-danger">

                                                Cancelled

                                            </span>

                                        </td>

                                    </tr>

                                </t>

                                <t t-else="">

                                    <tr>

                                        <td colspan="4"
                                            class="text-center p-4 text-muted">

                                            No fee records found.

                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </t>

    </template>

</odoo>
