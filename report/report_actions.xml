<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_report_student_profile"
                model="ir.actions.report">

            <field name="name">Student Profile</field>
            <field name="model">college.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">college_erp_ready.report_student_profile</field>
            <field name="report_file">college_erp_ready.report_student_profile</field>
            <field name="binding_model_id"
                   ref="model_college_student"/>
            <field name="binding_type">report</field>

        </record>

        <record id="action_report_student_id_card"
                model="ir.actions.report">

            <field name="name">Student ID Card</field>
            <field name="model">college.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">college_erp_ready.report_student_id_card</field>
            <field name="report_file">college_erp_ready.report_student_id_card</field>
            <field name="binding_model_id"
                   ref="model_college_student"/>
            <field name="binding_type">report</field>

        </record>

    </data>
</odoo>